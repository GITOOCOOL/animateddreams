# --- ComfyUI Connection Settings ---
# Code assumes local (127.0.0.1:8188) if VITE_COMFY_API_HOST is unset.

# OPTION 1: Remote Window Machine (Uncomment to use)
VITE_COMFY_API_HOST=http://172.20.10.3:8188

# OPTION 2: Local Machine (Active)
# VITE_COMFY_API_HOST=http://localhost:8188

# --- Ollama Connection Settings ---

# OPTION 1: Remote Ollama (Uncomment to use)
VITE_OLLAMA_API_HOST=http://172.20.10.3:11434

# Whisper Service (Optional - defaults to Windows Server Port 9000 if running)
VITE_WHISPER_API_URL=http://172.20.10.3:9000/v1/audio/transcriptions

# OPTION 2: Local Ollama (Active)
# VITE_OLLAMA_API_HOST=http://127.0.0.1:11434

# --- Ollama Model Settings ---
# Text Model: Used for text-only dreams (better reasoning)
VITE_OLLAMA_TEXT_MODEL=llama3:latest

# Vision Model: Used when images are attached (multimodal)
VITE_OLLAMA_VISION_MODEL=llava:latest

# Legacy fallback (can remain for safety)
VITE_OLLAMA_MODEL=llava